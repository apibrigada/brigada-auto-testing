{
  "version": 1,
  "description": "Form Engine v3 fixtures for UI hints, read_only, offline dataset filters, and guarded auto-advance.",
  "schemas": [
    {
      "id": "ui-helper-placeholder-readonly-dataset-filter-auto-advance",
      "schema": {
        "version": "3.0",
        "schema_version": 3,
        "engine": "form-engine-v3",
        "engine_version": 3,
        "settings": {
          "auto_advance": true
        },
        "sections": [
          {
            "key": "household",
            "title": "Hogar",
            "fields": [
              {
                "question_id": 101,
                "question_key": "applicant_name",
                "type": "text",
                "label": "Nombre",
                "required": true,
                "ui": {
                  "placeholder": "Nombre completo",
                  "helper_text": "Usa el nombre como aparece en la identificación."
                },
                "options": [],
                "validation_rules": {
                  "min_length": 3
                }
              },
              {
                "question_id": 102,
                "question_key": "state",
                "type": "single_choice",
                "label": "Estado",
                "required": true,
                "dataset_ref": "mx_estados",
                "ui": {
                  "placeholder": "Selecciona estado",
                  "helper_text": "Catálogo disponible sin conexión."
                },
                "options": [],
                "validation_rules": {}
              },
              {
                "question_id": 103,
                "question_key": "municipality",
                "type": "single_choice",
                "label": "Municipio",
                "required": true,
                "dataset_ref": "mx_municipios",
                "dataset_filter": {
                  "==": [
                    {
                      "var": "item.parent"
                    },
                    {
                      "var": "answers.state"
                    }
                  ]
                },
                "ui": {
                  "placeholder": "Selecciona municipio",
                  "helper_text": "La lista depende del estado elegido."
                },
                "options": [],
                "validation_rules": {}
              },
              {
                "question_id": 104,
                "question_key": "eligible",
                "type": "read_only",
                "label": "Elegibilidad",
                "required": false,
                "read_only": true,
                "calculated": {
                  "if": [
                    {
                      "==": [
                        {
                          "var": "answers.state"
                        },
                        "CDMX"
                      ]
                    },
                    "eligible",
                    "review"
                  ]
                },
                "ui": {
                  "helper_text": "Campo calculado por el motor."
                },
                "options": [],
                "validation_rules": {}
              },
              {
                "question_id": 105,
                "question_key": "has_documents",
                "type": "yes_no",
                "label": "¿Tiene documentos?",
                "required": true,
                "constraint": {
                  "==": [
                    {
                      "var": "answers.has_documents"
                    },
                    true
                  ]
                },
                "constraint_message": "No puede avanzar sin documentos.",
                "ui": {
                  "helper_text": "Auto-advance debe bloquearse si la respuesta viola la restricción."
                },
                "options": [],
                "validation_rules": {}
              },
              {
                "question_id": 106,
                "question_key": "contact_phone",
                "type": "text",
                "label": "Teléfono de contacto",
                "required": false,
                "ui": {
                  "placeholder": "+52 55 1234 5678",
                  "helper_text": "Usa un teléfono local si está disponible.",
                  "keyboard_type": "phone-pad",
                  "appearance": "minimal",
                  "icon": "phone"
                },
                "options": [],
                "validation_rules": {}
              },
              {
                "question_id": 107,
                "question_key": "symptoms_image_grid",
                "type": "multiple_choice_image",
                "label": "Síntomas visibles",
                "required": false,
                "ui": {
                  "helper_text": "La cuadrícula usa columnas configuradas por schema.",
                  "columns": 3,
                  "appearance": "compact",
                  "icon": "image"
                },
                "options": [
                  {
                    "value": "rash",
                    "label": "Erupción",
                    "image_url": "https://example.test/rash.png"
                  },
                  {
                    "value": "cough",
                    "label": "Tos",
                    "image_url": "https://example.test/cough.png"
                  },
                  {
                    "value": "fever",
                    "label": "Fiebre",
                    "image_url": "https://example.test/fever.png"
                  }
                ],
                "validation_rules": {
                  "min_selections": 1,
                  "max_selections": 2
                }
              },
              {
                "question_id": 108,
                "question_key": "route_manual",
                "type": "gis_tracking_manual",
                "label": "Recorrido manual",
                "required": false,
                "ui": {
                  "helper_text": "Agrega puntos GPS manualmente sin conexión.",
                  "icon": "gps"
                },
                "options": [],
                "validation_rules": {
                  "min_points": 2,
                  "max_duration_s": 600
                }
              },
              {
                "question_id": 109,
                "question_key": "route_auto",
                "type": "gis_tracking_auto",
                "label": "Recorrido automático",
                "required": false,
                "ui": {
                  "helper_text": "Registra el recorrido con GPS del dispositivo.",
                  "icon": "map"
                },
                "options": [],
                "validation_rules": {
                  "min_points": 2,
                  "max_duration_s": 600,
                  "interval_s": 5,
                  "distance_interval_m": 5
                }
              },
              {
                "question_id": 110,
                "question_key": "ine_capture",
                "type": "ine_ocr",
                "label": "INE",
                "required": true,
                "ui": {
                  "helper_text": "Los campos marcados como requeridos bloquean el avance hasta estar completos.",
                  "icon": "document"
                },
                "options": [],
                "validation_rules": {
                  "required_fields": [
                    "front",
                    "back",
                    "nombre",
                    "curp",
                    "ocrNumber"
                  ]
                }
              }
            ]
          }
        ]
      },
      "dataset_items": {
        "mx_estados": [
          {
            "value": "CDMX",
            "label": "Ciudad de México"
          },
          {
            "value": "JAL",
            "label": "Jalisco"
          }
        ],
        "mx_municipios": [
          {
            "value": "CUAUHTEMOC",
            "label": "Cuauhtémoc",
            "parent": "CDMX"
          },
          {
            "value": "GUADALAJARA",
            "label": "Guadalajara",
            "parent": "JAL"
          }
        ]
      },
      "expected": {
        "helper_text_fields": [
          "applicant_name",
          "state",
          "municipality",
          "eligible",
          "has_documents",
          "contact_phone",
          "symptoms_image_grid",
          "route_manual",
          "route_auto",
          "ine_capture"
        ],
        "placeholder_fields": [
          "applicant_name",
          "state",
          "municipality",
          "contact_phone"
        ],
        "read_only_fields": [
          "eligible"
        ],
        "dataset_filter_field": "municipality",
        "auto_advance_block_field": "has_documents",
        "advanced_ui_fields": {
          "contact_phone": {
            "keyboard_type": "phone-pad",
            "appearance": "minimal",
            "icon": "phone"
          },
          "symptoms_image_grid": {
            "columns": 3,
            "appearance": "compact",
            "icon": "image"
          }
        },
        "gis_tracking_fields": [
          "route_manual",
          "route_auto"
        ],
        "ine_required_field": "ine_capture"
      }
    }
  ]
}
